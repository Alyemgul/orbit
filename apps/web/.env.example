# Copy to .env.local and fill in from Supabase: Project Settings -> API.
# Without these the app runs in local preview mode (no sign-in, no data).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Public URL used in magic-link emails. Optional locally.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Comma-separated invite list. Leave empty to allow any email to sign in.
ALLOWED_EMAILS=you@example.com,friend@example.com

# Optional AI rewording for resume tailoring (server-only, free providers).
# Set one or both keys: Groq is tried first, and Gemini takes over when Groq's
# free limit runs out (or the other way round with LLM_PROVIDER=gemini).
GROQ_API_KEY=
GEMINI_API_KEY=
# LLM_PROVIDER=ollama   # local Ollama instead (no key); "none" turns AI off
# LLM_API_KEY=          # older single-key setup, used with LLM_PROVIDER=groq|gemini
# LLM_MODEL=llama-3.3-70b-versatile
# Used when the main model is rate-limited (Groq default: llama-3.1-8b-instant).
# LLM_FALLBACK_MODEL=llama-3.1-8b-instant
