# Copy to .env.local and fill in from Supabase: Project Settings -> API.
# Without these the app runs in local preview mode (no sign-in, no data).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Public URL used in magic-link emails. Optional locally.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Comma-separated invite list. Leave empty to allow any email to sign in.
ALLOWED_EMAILS=you@example.com,friend@example.com
