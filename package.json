{
  "name": "orbit",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @orbit/web",
    "build": "npm run build -w @orbit/web",
    "start": "npm run start -w @orbit/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "ingest": "npm run ingest -w @orbit/ingest --",
    "build:extension": "npm run build -w @orbit/extension"
  },
  "engines": {
    "node": ">=20.11"
  },
  "overrides": {
    "jsdom": "26.1.0"
  },
  "devDependencies": {
    "jsdom": "26.1.0"
  }
}
